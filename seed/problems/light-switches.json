{
  "slug": "light-switches",
  "title": "Light Switches",
  "statement": "A hall has many lights, and each light has its own switch number. All lights start off. You are given the list of switches that were pressed, in order. Each press flips that switch's light: off becomes on, and on becomes off.\n\nPrint the switch numbers of the lights that are on after all presses.",
  "inputFormat": "Line 1: one integer `n`, the number of presses.\nLine 2: `n` integers `b[1] ... b[n]`, the switch numbers pressed, separated by single spaces.",
  "outputFormat": "Print the switch numbers of the lights that are on, in increasing numeric order, on one line separated by single spaces. If no light is on, print `NONE`.",
  "constraints": "1 ≤ n ≤ 5000\n1 ≤ b[i] ≤ 1000000000",
  "topic": "hashing",
  "difficulty": "easy",
  "timeLimitMs": 2000,
  "samples": [
    {
      "input": "6\n12 5 12 8 30 5\n",
      "explanation": "Switches 12 and 5 are pressed twice each, so their lights end off. Switches 8 and 30 are pressed once each, so their lights end on. Answer: 8 30."
    },
    {
      "input": "4\n3 3 6 6\n",
      "explanation": "Every switch is pressed twice, so every light ends off. Answer: NONE."
    }
  ],

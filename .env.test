NODE_ENV=test
PORT=5000
MONGODB_URI=mongodb+srv://test:test@test.mongodb.net/test
JWT_SECRET=test-secret-key-that-is-long-enough-for-validation
JWT_EXPIRES_IN=1d
BCRYPT_COST=10
